    "# 1) Target / class distribution (using the decoded labels from 4.1 for readability)\n",
    "plt.figure(figsize=(6, 4))\n",
    "order = target_named.value_counts().index\n",
    "sns.countplot(x=target_named, order=order, hue=target_named, palette=\"viridis\", legend=False)\n",
    "plt.title(\"Target distribution (class imbalance)\")\n",
    "plt.xlabel(\"Target\")\n",
    "plt.ylabel(\"Number of students\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 2) Approved curricular units by Target (raw counts -- not affected by the Task 3.3 scaling)\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11, 4.5))\n",
    "sns.boxplot(x=target_named, y=df_transformed[\"Curricular units 1st sem (approved)\"],\n",
    "            order=order, hue=target_named, palette=\"viridis\", legend=False, ax=axes[0])\n",
    "axes[0].set_title(\"1st sem approved units by Target\")\n",
    "axes[0].set_xlabel(\"Target\")\n",
    "sns.boxplot(x=target_named, y=df_transformed[\"Curricular units 2nd sem (approved)\"],\n",
    "            order=order, hue=target_named, palette=\"viridis\", legend=False, ax=axes[1])\n",
    "axes[1].set_title(\"2nd sem approved units by Target\")\n",
    "axes[1].set_xlabel(\"Target\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 3) Age at enrollment distribution, with the IQR outlier boundary from Task 3.2 marked\n",
    "plt.figure(figsize=(6, 4))\n",
    "sns.histplot(df_transformed[\"Age at enrollment\"], bins=30, kde=True, color=\"teal\")\n",
    "plt.axvline(34, color=\"red\", linestyle=\"--\", label=\"IQR outlier bound (34 yrs)\")\n",
    "plt.title(\"Age at enrollment (right-skewed)\")\n",
    "plt.xlabel(\"Age at enrollment\")\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 4) Correlation heatmap for the numeric features most relevant to the problem\n",
